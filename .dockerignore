# The build context is the repo root, and the image installs its own
# dependencies — copying the host's would layer a developer's machine (and its
# platform-specific binaries) on top of what `npm ci` just resolved.
node_modules
**/node_modules

# Build output, all of it regenerated inside the image or irrelevant to it.
**/dist
packages/gql/src
apps/mobile/android
apps/mobile/ios

.git
