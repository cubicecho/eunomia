# Server
# Compose publishes postgres on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgres://eunomia:eunomia@localhost:5433/eunomia
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:4000
PORT=4000

# Where the web dashboard is served; emailed magic links point here.
APP_URL=http://localhost:3000

# Magic-link email delivery. Without SMTP_HOST, links are printed to the
# server console instead of emailed.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#EMAIL_FROM=eunomia <noreply@example.com>

# DANGER: when true, requestMagicLink returns the sign-in token directly in
# the GraphQL response — anyone who can reach the server can log in as any
# email address. Only for trusted local networks / dev.
UNSAFE_LOCAL_NETWORK=false
