# Server
# Compose publishes postgres on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgres://eunomia:eunomia@localhost:5433/eunomia
# Signs every session token. Required: the server refuses to start without a
# real one (unless UNSAFE_LOCAL_NETWORK=true). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
PORT=4000

# Time zone for day boundaries on the dashboard (IANA name). Set this to YOUR
# zone before real data accrues — already-rolled summaries keep the day they
# were bucketed into and won't re-bucket if it changes later.
TZ=UTC

# Days of raw per-activity rows to keep. Summaries are never pruned, so the
# charts keep full history; only window titles and the ability to
# re-categorize individual old activities age out. 0 = keep raw rows forever.
ACTIVITY_RETENTION_DAYS=90

# Where emailed magic links point. The deployed container serves the web
# dashboard itself, so this defaults to BETTER_AUTH_URL — only set it when the
# dashboard lives elsewhere (e.g. the vite dev server on :3000).
#APP_URL=

# Magic-link email delivery. Without SMTP_HOST, links are printed to the
# server console instead of emailed.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#EMAIL_FROM=eunomia <noreply@example.com>

# Who may hold an account. ALLOWED_EMAILS is a comma-separated list; an entry
# of *@example.com allows a whole domain. Empty = anyone who can reach the
# server can sign up, which is fine on a LAN and not on the internet.
#ALLOWED_EMAILS=
# Closes sign-ups entirely: existing accounts still sign in, new ones can't be
# created. Set this once your own account exists.
DISABLE_SIGNUP=false

# DANGER: when true, requestMagicLink returns the sign-in token directly in
# the GraphQL response — anyone who can reach the server can log in as any
# email address (and skips the BETTER_AUTH_SECRET check). Only for trusted
# local networks / dev.
UNSAFE_LOCAL_NETWORK=false
