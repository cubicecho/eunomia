{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!release",
      "!package-lock.json",
      "!schema.graphql",
      "!packages/gql/src",
      "!apps/app/electron/tray-icon.ts",
      "!apps/app/dist-web",
      "!apps/server/drizzle",
      "!site"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/ui/**",
        "apps/web/src/components/card-layout.tsx",
        "apps/web/src/components/centered-layout.tsx",
        "apps/web/src/components/combobox.tsx",
        "apps/web/src/components/confirm-button.tsx",
        "apps/web/src/components/dialog-layout.tsx",
        "apps/web/src/components/disclosure.tsx",
        "apps/web/src/components/empty-state.tsx",
        "apps/web/src/components/field-row.tsx",
        "apps/web/src/components/form-field.tsx",
        "apps/web/src/components/header-content-footer.tsx",
        "apps/web/src/components/page-header.tsx",
        "apps/web/src/components/query-state.tsx",
        "apps/web/src/components/stat-tile.tsx",
        "apps/web/src/lib/color.ts",
        "apps/web/src/lib/readable-text-color.ts",
        "apps/web/src/lib/select-options.ts",
        "apps/web/src/lib/utils.ts",
        "apps/web/cubeui-*.css"
      ],
      "linter": {
        "enabled": false
      }
    }
  ]
}
