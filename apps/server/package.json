    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vantreeseba/drizzle-graphql": "^7.9.1",
    "@vantreeseba/graphql-casl": "^1.3.0",
    "better-auth": "^1.6.29",
    "drizzle-orm": "1.0.0-rc.2-e38a2ba",
    "graphql": "^16.11.0",
    "graphql-middleware": "^6.1.35",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.10.0",
