{
  "name": "@eunomia/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "drizzle-kit migrate && tsx src/index.ts",
    "db:push": "drizzle-kit push",
