{
  "name": "@eunomia/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@eunomia/agent": "*",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-background-task": "~57.0.14",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "EUNOMIA_ALLOW_CLEARTEXT=1 expo run:android --variant release",
    "prebuild": "expo prebuild --platform android",
    "apk": "EUNOMIA_ALLOW_CLEARTEXT=1 expo prebuild --platform android && cd android && ./gradlew assembleRelease && echo \"APK: $(pwd)/app/build/outputs/apk/release/app-release.apk\"",
    "apk:eas": "eas build --platform android --profile preview",
    "apk:eas:local": "eas build --platform android --profile preview --local",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
